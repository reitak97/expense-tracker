# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- Shared by both processes (API and worker) ---
# NOTE: use Supabase's POOLER hostnames, not db.<project-ref>.supabase.co.
# The direct host is IPv6-only, and most home/office networks have no IPv6
# route to it — you get "Can't reach database server" even when the project is
# perfectly healthy. Copy both strings from:
#   Supabase dashboard -> Project Settings -> Database -> Connection string
#
# Queries: transaction pooler, port 6543. pgbouncer=true tells Prisma to skip
# prepared statements, which the transaction pooler cannot support.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Migrations only: session pooler, port 5432. DDL needs session state that the
# transaction pooler multiplexes away. Prisma reads this for `migrate`/`db push`
# and never for ordinary queries.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- API only (server/index.js) ---
PORT=3001
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
ANTHROPIC_API_KEY=sk-ant-...

# --- Worker only (server/worker.js) ---
# Region the queues live in, e.g. us-east-1. Must match where you created them.
AWS_REGION=us-east-1
# Full URL of the main queue, copied from the SQS console. Looks like:
# https://sqs.us-east-1.amazonaws.com/123456789012/expense-imports
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/.../expense-imports

# --- AWS credentials (needed by whichever process talks to SQS) ---
# The AWS SDK reads these two from process.env automatically — no code ever
# passes them to a client constructor. That invisibility is exactly why
# validateEnv() lists them: without it, a missing key surfaces as a confusing
# auth error on the first API call instead of a clear failure at startup.
# Use an IAM user scoped to just these queues, never root credentials.
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
